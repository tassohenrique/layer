DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-em-producao
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcional: sem essa variável, o app usa SQLite local (db.sqlite3) — bom
# pra rodar sem instalar nada. Setar aqui pra usar Postgres (ex.: crie um
# projeto no Supabase só pelo Postgres e cole a connection string).
# DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco
